# Copy this file to .env and fill in real values. Never commit your real .env.
# The verify recipe and deploy notes are in docs/CONVENTIONS.md.

# --- Required ---

# PostgreSQL connection string.
# Local dev (see docs/CONVENTIONS.md for the one-time role/db setup):
DATABASE_URL="postgresql://app:app@localhost:5432/opip"

# Auth.js session secret. Generate one with:  openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# The app's own public URL (used by Auth.js). Local dev value:
AUTH_URL="http://localhost:3000"

# Where uploaded property images are written. On Railway this is the mounted
# volume path (DATA_DIR=/data); without a volume, photos are wiped every deploy.
DATA_DIR="./.data"

# Password for the seeded admin login (admin@example.com) created by `npm run db:seed`.
# The same password seeds the sample agency login (agency@example.com).
SEED_ADMIN_PASSWORD="change-me"

# --- AI analyst (Phase 4) ---

# Anthropic API key that powers the AI analyst on property pages. Without it the
# analyst card shows a friendly "not switched on yet" message and everything
# else works. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=""

# --- Optional ---

# Map tile server. The default OpenStreetMap tiles are fine for low traffic /
# local dev only — swap to a Carto/Protomaps URL before real production traffic.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png"
